# API backend Go. Contract default: http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Required only for direct PDF upload from Admin to Supabase Storage.
# Use a public bucket named "problems" or set VITE_SUPABASE_BUCKET accordingly.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_BUCKET=problems
